CHORE_TIMEZONE=America/Los_Angeles
CHORE_PORT=5000
CHORE_HOST=0.0.0.0
CHORE_DATABASE=data/chore_touchscreen.db
CHORE_WORKBOOK="data/Apartment Routine.xlsx"
CHORE_UPCOMING_DAYS=7

# Weather (Open-Meteo; no API key required)
# Enter the latitude/longitude for the apartment.
DASHBOARD_LATITUDE=
DASHBOARD_LONGITUDE=

# Google Calendar
# Google Calendar > Settings > Integrate calendar > Secret address in iCal format
# Keep this URL private; it provides read access to the calendar.
GOOGLE_CALENDAR_ICAL_URL=

# Hey Bellamy voice assistant
# If omitted, VOICE_DASHBOARD_URL automatically uses http://127.0.0.1:$CHORE_PORT.
VOICE_DASHBOARD_URL=
VOICE_WAKE_ALIASES="hey bellamy,hey belamy,hey bellamy"
VOICE_WHISPER_DIR="~/.local/share/whisper.cpp"
VOICE_WHISPER_MODEL="~/.local/share/whisper.cpp/models/ggml-tiny.en.bin"
VOICE_CAPTURE_ID=0
VOICE_ALSA_DEVICE=default
VOICE_THREADS=4
VOICE_AUDIO_CONTEXT=512
VOICE_WAKE_STEP_MS=2000
VOICE_WAKE_LENGTH_MS=5000
VOICE_COMMAND_SECONDS=6
VOICE_TTS_ENABLED=1
