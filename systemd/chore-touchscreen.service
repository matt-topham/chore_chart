[Unit]
Description=Chore Touchscreen Web App
After=network.target

[Service]
Type=simple
User=CHORE_USER
WorkingDirectory=CHORE_PATH
Environment=PYTHONUNBUFFERED=1
Environment=CHORE_TIMEZONE=America/Denver
ExecStart=CHORE_PATH/.venv/bin/python CHORE_PATH/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
